<!DOCTYPE html>
<html>
<head>
    <title>Miniflux Digest Overview</title>
</head>
<body>
    <h1>Miniflux Digest Overview</h1>
    <p>{{.Summary}}</p>

    <h2>Grouped Digests</h2>
    <ul>
        {{range .EntryGroups}}
            <li>
                <h3><a href="{{.Slug}}.html">{{.Title}}</a></h3>
                <p>{{.Summary}}</p>
            </li>
        {{end}}
    </ul>
</body>
</html>