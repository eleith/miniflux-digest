<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{.PrimaryGroup.Title}}</title>
	<meta property="og:title" content="{{.PrimaryGroup.Title}}">
    <meta property="og:description" content="{{.PrimaryGroup.Summary}}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{.DigestHost}}/digests/{{.PrimaryGroup.Slug}}.html">
    <meta property="og:image" content="{{.DigestHost}}/static/images/opengraph.png">
	<link rel="icon" type="image/png" href="{{.DigestHost}}/static/images/favicon.png">
	<style>
		{{include "static/style.css"}}

		{{range .FeedIcons}} div.feed-icon-{{.FeedID}} {
			background-image: url("data:{{.Data}}");
			background-size: contain;
			width: 16px;
			height: 16px;
		}
		{{end}}
	</style>
</head>

<body>
	<div class="container">
		<section class="header">
			<h1 class="title">{{.PrimaryGroup.Title}}</h1>
			<p class="subtitle">
				generated <a href=".." title="Back to Overview">{{.GeneratedDate.Format "Jan 2, 2006"}}</a>, with {{.PrimaryGroup.TotalEntries}} entries from {{.PrimaryGroup.TotalFeeds}} feeds.
			</p>
		</section>

		{{if .PrimaryGroup.Summary}}
		<section class="summary">
			<h2 class="group-entries-title">Summary</h2>
			<div>{{textToHTML .PrimaryGroup.Summary}}</div>
		</section>
		{{end}}

		<section class="entries">
    {{range .PrimaryGroup.SubGroups}}
    <h3 class="sub-group-title">{{.Title}}</h3>
        {{range .Entries}}
        <section class="entry" data-entry-id="{{.ID}}">
            <details class="entry">
                <summary class="entry">
                    {{.Title}}
                </summary>
                <div class="entry-content">
                    {{ htmlEscape .Content}}
                </div>
            </details>
            <div class="entry-meta">
                <div class="entry-meta-tab entry-meta-tab-feed">
                    <div class="feed-icon-{{.FeedID}}"></div>
                    <div class="entry-meta-tab-feed-title">{{.FeedTitle}}</div>
                </div>
                <div class="entry-meta-tab" style="margin-left: auto;">{{.Date.Format
                    "Jan 2"}}</div>
                <div class="entry-meta-tab">
                    <a href="{{.URL}}" target="_blank" rel="noopener noreferrer" class="entry-link"
                        data-link-external>permalink</a>
                </div>
                {{if .CommentsURL}}
                <div class="entry-meta-tab">
                    <a href="{{.CommentsURL}}" target="_blank" rel="noopener noreferrer" class="entry-link"
                        data-link-comments>comments</a>
                </div>
                {{end}}
                <div class="entry-meta-tab">
                    <a href="{{$.MinifluxHost}}/feed/{{.FeedID}}/entry/{{.ID}}" target="_blank" rel="noopener noreferrer"
                        class="entry-link" data-link-internal>source</a>
                </div>
            </div>
        </section>
        {{end}}
    {{end}}
</section>
	</div>

	<script>
		{{include "static/grouped-entries.js"}}
	</script>
</body>

</html>
