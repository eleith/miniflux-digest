miniflux:
  host: "YOUR_MINIFLUX_URL"
  api_token: "YOUR_MINIFLUX_API_API_KEY"

smtp:
  host: "YOUR_SMTP_HOST"
  port: 587 # Or your SMTP port
  user: "YOUR_SMTP_USERNAME"
  password: "YOUR_SMTP_PASSWORD"

digest:
  email:
    to: "RECIPIENT@example.com"
    from: "SENDER@example.com"
  schedule: "@every 24h"
  host: "https://your-digest-host.com" # URL where HTML archives will be served
  compress: true
  mark_as_read: true
  run_on_startup: false
  group_by: "category" # choices: category, feed
  sub_group_by: "day" # choices: date, feed, ai
  sort_by: "date" # choices: date, title, ai

ai:
  api_key: "YOUR_GEMINI_API_KEY"
