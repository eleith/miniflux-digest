miniflux:
  host: "https://reader.miniflux.app"
  api_token: "YOUR_MINIFLUX_API_TOKEN"

smtp:
  host: "smtp.example.com"
  port: 587
  user: "smtp_user"
  password: "smtp_password"

ai:
  api_key: "YOUR_GEMINI_API_KEY"

digests:
  - title: "Daily Tech"
    schedule: "0 8 * * *"
    host: "https://digest.example.com"
    view: "ai"
    mark_as_read: true
    email:
      to: "recipient@example.com"
      from: "sender@example.com"
    filters:
      feed_titles: ["Hacker News", "Ars Technica"]
      category_titles: ["Technology"]
    categories:
      - title: "AI & LLMs"
        description: "Artificial intelligence, machine learning, and LLM news."
      - title: "Programming"
        description: "Software development, languages, and tools."

  - title: "Weekly Catch-All"
    schedule: "@weekly"
    host: "https://digest.example.com"
    view: "date"
    email:
      to: "recipient@example.com"
      from: "sender@example.com"
